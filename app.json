{
  "expo": {
    "extra": {
      "eas": {
        "projectId": "31142275-1fbd-4a25-b8ef-9518182f366c"
      }
    },
    "owner": "azfarsuhail",
    "scheme": "kneeoa",
    "android": {
      "package": "com.azfarsuhail.kneeoaapp",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kneeoa.online",
              "pathPrefix": "/reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow KneeOA Engine to access the camera to capture knee X-ray images.",
          "photosPermission": "Allow KneeOA Engine to access your photo library for X-ray uploads."
        }
      ]
    ]
  }
}
